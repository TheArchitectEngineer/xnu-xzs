 /* Reset and configure physical endpoints */
 static void dwc3_configure_endpoints(void)
 {
+	/*
+	 * Historical rc prints below copied DEPCMD[3:0]. That nibble is the
+	 * opcode (9/1/2), not DEPCMD.STATUS in bits [15:12]. This block stays
+	 * excluded from the image.
+	 */
 	xzs_early_puts("[XZS-USB] DEPSTARTCFG on EP0\n");
 	int rc = dwc3_ep_cmd(DWC3_PHYS_EP_CTRL_OUT, DEPCMD_STARTNEWCFG, 0, 0, 0);
 	xzs_early_puts("[XZS-USB] DEPSTARTCFG rc="); xzs_d6m4_put_hex64(rc); xzs_early_puts("\n");
@@ -1038,11 +1043,45 @@ static volatile enum xzs_t1y_completion s_t1y_completion = XZS_T1Y_COMPLETE_NONE
 static volatile boolean_t s_t1y_ep0_setup_armed = FALSE;
 static volatile boolean_t s_t1y_three_stage = FALSE;
 
+/*
+ * DEPCMD bits [3:0] stay equal to the opcode after CMDACT clears.
+ * Completion status is bits [15:12]. A zero low nibble is not success.
+ */
+static void
+xzs_depcmd_emit(uint32_t opcode, uint32_t raw_before, uint32_t raw_after,
+    int completed)
+{
+	uint32_t cmdact = (raw_after & DEPCMD_CMDACT) ? 1u : 0u;
+
+	xzs_early_puts("DEPCMD_RAW_BEFORE=");
+	xzs_d6m4_put_hex64(raw_before);
+	xzs_early_puts("\nDEPCMD_RAW_AFTER=");
+	xzs_d6m4_put_hex64(raw_after);
+	xzs_early_puts("\nDEPCMD_OPCODE=");
+	xzs_d6m4_put_hex64(opcode & 0x0fu);
+	xzs_early_puts("\nDEPCMD_CMDACT_AFTER=");
+	xzs_d6m4_put_hex64(cmdact);
+	xzs_early_puts("\nDEPCMD_STATUS=");
+	if (completed && cmdact == 0) {
+		xzs_d6m4_put_hex64(DEPCMD_STATUS(raw_after));
+		xzs_early_puts("\n");
+	} else {
+		xzs_early_puts("UNAVAILABLE\n");
+	}
+	if ((opcode & 0x0fu) == DEPCMD_STARTTRANSFER && completed && cmdact == 0) {
+		xzs_early_puts("TRANSFER_RESOURCE_INDEX=");
+		xzs_d6m4_put_hex64(DEPCMD_RESOURCE_INDEX(raw_after));
+		xzs_early_puts("\n");
+	}
+}
